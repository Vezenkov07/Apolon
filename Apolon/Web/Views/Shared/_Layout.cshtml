<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Apolon Gym</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <!-- Your navigation bar goes here -->
        <nav class="site-nav navbar navbar-expand-lg navbar-dark">
            <div class="container">
                <a class="navbar-brand brand-mark fw-bold text-uppercase" asp-controller="Home" asp-action="Index">
                    <span>▲</span> Apolon
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="mainNavigation" class="navbar-collapse collapse justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link text-light" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link text-light" asp-controller="Trainers" asp-action="Index">Trainers</a></li>
                        <li class="nav-item"><a class="nav-link text-light" asp-controller="Workouts" asp-action="Index">Workouts</a></li>
                        <li class="nav-item"><a class="nav-link text-warning fw-bold" asp-controller="Cards" asp-action="Index">Memberships</a></li>
                        <li class="nav-item"><a class="nav-link text-light" asp-controller="Supplements" asp-action="Index">Store</a></li>
                        <li class="nav-item"><a class="nav-link text-light" asp-controller="Home" asp-action="AboutUs">About us</a></li>
                    </ul>
                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <!-- Shown only to logged-in users -->
                            <li class="nav-item me-3 text-light d-none d-xl-block">
                                Hi, <strong>@User.Identity.Name</strong>
                            </li>
                            <li class="nav-item me-2">
                                <a class="btn btn-primary" asp-controller="Account" asp-action="Index">My Account</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-danger" asp-controller="Account" asp-action="Logout">Log Out</a>
                            </li>
                        }
                        else
                        {
                            <!-- Shown only to guests -->
                            <li class="nav-item me-2">
                                <a class="btn btn-outline-light" asp-controller="Account" asp-action="Login">Log In</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-warning text-dark fw-bold" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container site-main">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted text-center py-3">
        <div class="container">
            &copy; 2026 - Apolon Gym
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>