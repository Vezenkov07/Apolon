@model IEnumerable<Apolon.Data.Models.Trainer>

@{
    ViewData["Title"] = "Our Trainers";
}

<div class="text-center mb-5 mt-4">
    <h1 class="display-4 fw-bold">Meet Our Trainers</h1>
    <p class="text-muted lead">Expert coaches dedicated to pushing your limits.</p>
</div>

<!-- Grid setup: 1 column on mobile, 2 on tablets, 3 on large screens -->
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
    
    @if (Model != null && Model.Any())
    {
        <!-- Renders real trainers once your database is connected -->
        foreach (var trainer in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 bg-light">
                    <img src="@trainer.ImageUrl" class="card-img-top" alt="@trainer.FirstName" style="height: 350px; object-fit: cover; object-position: top;">
                    <div class="card-body d-flex flex-column p-4">
                        <h4 class="card-title fw-bold">@trainer.FirstName @trainer.LastName</h4>
                        <p class="text-muted small mb-3">
                            <strong>Email:</strong> @trainer.Email <br/>
                            <strong>Phone:</strong> @trainer.PhoneNumber
                        </p>
                        <p class="card-text mb-4">
                            @(string.IsNullOrEmpty(trainer.Description) ? "Professional fitness coach ready to help you achieve your goals." : trainer.Description)
                        </p>
                        <a href="#" class="btn btn-outline-dark mt-auto fw-semibold w-100">Book Session</a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <!-- Placeholder 1 -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0 bg-light">
                <img src="https://images.unsplash.com/photo-1594381898411-846e7d193883?q=80&w=800&auto=format&fit=crop" class="card-img-top" alt="Trainer Placeholder" style="height: 350px; object-fit: cover; object-position: top;">
                <div class="card-body d-flex flex-column p-4">
                    <h4 class="card-title fw-bold">Ivan Ivanov</h4>
                    <p class="text-muted small mb-3">
                        <strong>Email:</strong> ivan@@apolon.bg <br/>
                        <strong>Phone:</strong> +359 88 111 2222
                    </p>
                    <p class="card-text mb-4">Specializes in powerlifting and strength conditioning. Ivan has over 10 years of experience helping athletes break their personal records.</p>
                    <button class="btn btn-outline-dark mt-auto fw-semibold w-100" disabled>Coming Soon</button>
                </div>
            </div>
        </div>
        
        <!-- Placeholder 2 -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0 bg-light">
                <img src="https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?q=80&w=800&auto=format&fit=crop" class="card-img-top" alt="Trainer Placeholder" style="height: 350px; object-fit: cover; object-position: top;">
                <div class="card-body d-flex flex-column p-4">
                    <h4 class="card-title fw-bold">Maria Georgieva</h4>
                    <p class="text-muted small mb-3">
                        <strong>Email:</strong> maria@@apolon.bg <br/>
                        <strong>Phone:</strong> +359 88 333 4444
                    </p>
                    <p class="card-text mb-4">An expert in hypertrophy and mobility. Maria will help you build muscle mass while keeping your joints healthy and flexible.</p>
                    <button class="btn btn-outline-dark mt-auto fw-semibold w-100" disabled>Coming Soon</button>
                </div>
            </div>
        </div>

        <!-- Placeholder 3 -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0 bg-light">
                <img src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=800&auto=format&fit=crop" class="card-img-top" alt="Trainer Placeholder" style="height: 350px; object-fit: cover; object-position: top;">
                <div class="card-body d-flex flex-column p-4">
                    <h4 class="card-title fw-bold">Dimitar Petrov</h4>
                    <p class="text-muted small mb-3">
                        <strong>Email:</strong> dimitar@@apolon.bg <br/>
                        <strong>Phone:</strong> +359 88 555 6666
                    </p>
                    <p class="card-text mb-4">Former competitive bodybuilder focusing on aesthetics and contest prep. Dimitar knows exactly how to dial in your nutrition and training.</p>
                    <button class="btn btn-outline-dark mt-auto fw-semibold w-100" disabled>Coming Soon</button>
                </div>
            </div>
        </div>
    }
</div>