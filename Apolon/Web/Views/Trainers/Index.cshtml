@model IEnumerable<Apolon.Data.Models.Trainer>

@{
    ViewData["Title"] = "Our Trainers";
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show text-center shadow-sm my-4" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<div class="page-heading mt-5">
    <div class="hero-kicker justify-content-center">Your new unfair advantage</div>
    <h1 class="display-5 fw-bold">Meet the coaches</h1>
    <p>Expert coaches dedicated to pushing your limits.</p>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
    
    @if (Model != null && Model.Any())
    {
        foreach (var trainer in Model)
        {
            <div class="col">
                <div class="trainer-card card border-0">
                    <img src="@trainer.ImageUrl" class="card-img-top" alt="@trainer.FirstName @trainer.LastName">
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                            <h4 class="card-title fw-bold mb-0">@trainer.FirstName @trainer.LastName</h4>
                            <span class="badge bg-warning text-dark">Coach</span>
                        </div>
                        <p class="card-text text-muted mb-4">@trainer.Description</p>
                        <div class="small text-muted mb-4">@trainer.Email<br />@trainer.PhoneNumber</div>
                        <a asp-controller="Trainers" asp-action="Book" asp-route-trainerId="@trainer.TrainerId" class="btn btn-warning mt-auto w-100">Book a session</a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info text-center" role="status">
            Trainer bookings are temporarily unavailable. Please check back soon.
        </div>
    }
</div>