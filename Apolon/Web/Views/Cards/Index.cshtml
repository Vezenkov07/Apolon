@model IReadOnlyCollection<Apolon.Data.Models.ViewModels.CardOfferViewModel>

@{
    ViewData["Title"] = "Memberships";
}

<div class="py-4">
    <div class="page-heading">
        <div class="hero-kicker justify-content-center">Commit to your strongest self</div>
        <h1 class="display-5 fw-bold">Choose your membership</h1>
        <p>Simple plans. Serious results.</p>
    </div>
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4">
        @foreach (var offer in Model)
        {
            <div class="col">
                <div class="membership-card card border-0">
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h2 class="h4 fw-bold mb-0">@offer.CardType</h2>
                            @if (offer.CardType == Apolon.Data.Models.Enums.CardTypes.Premium)
                            {
                                <span class="badge bg-warning text-dark">Best value</span>
                            }
                        </div>
                        <p class="text-muted flex-grow-1">@offer.Description</p>
                        <div class="fs-3 fw-bold text-warning mb-3">@offer.Price.ToString("F2") лв.</div>
                        <form asp-action="Buy" method="get">
                            <input type="hidden" name="CardType" value="@offer.CardType" />
                            <button class="btn btn-warning w-100 fw-bold" type="submit">Buy membership</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
