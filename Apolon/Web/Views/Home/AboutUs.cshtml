@{
    ViewData["Title"] = "About Us";
}

<!-- Hero Section -->
<div class="text-center text-white p-5 rounded-3 mb-5 shadow-lg" 
     style="background: linear-gradient(rgba(0, 0, 0, 0.8), rgba(0, 0, 0, 0.8)), url('https://images.unsplash.com/photo-1571019614242-c5c5dee9f50b?q=80&w=2070&auto=format&fit=crop') no-repeat center center; background-size: cover; padding-top: 80px !important; padding-bottom: 80px !important;">
    <h1 class="display-4 fw-bold mb-3 mt-4">About Apolon Gym</h1>
    <p class="lead mb-0 fw-normal">Built for the community. Dedicated to your strength.</p>
</div>

<!-- Content Section -->
<div class="container mb-5">
    <div class="row gx-5 align-items-center">
        <!-- Text Column -->
        <div class="col-lg-6 mb-4 mb-lg-0">
            <h3 class="fw-bold mb-3">Our Story</h3>
            <p class="text-muted">
                Apolon Gym started with a simple mission right here in our hometown: to create a space where absolute beginners and seasoned athletes alike feel driven to push their limits. We believe fitness is more than just lifting weights—it is about building discipline, resilience, and a fiercely supportive community.
            </p>
            <p class="text-muted">
                From our premium, hand-selected equipment to our dedicated coaching staff, every detail of Apolon has been designed to help you crush your goals. Whether you are exploring our supplement store, following a customized workout split, or sweating it out with our trainers, you are part of the Apolon family.
            </p>
        </div>
        
        <!-- Info Card Column -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-4">Gym Information</h4>
                    
                    <p class="mb-1 fw-bold">📍 Location:</p>
                    <p class="text-muted mb-3">123 Fitness Blvd, Central District</p>
                    
                    <p class="mb-1 fw-bold">⏰ Operating Hours:</p>
                    <ul class="text-muted mb-3 list-unstyled ms-3">
                        <li><strong>Mon - Fri:</strong> 08:00 - 21:00</li>
                        <li><strong>Saturday & Sunday:</strong> 08:00 - 20:00</li>
                    </ul>
                    
                    <p class="mb-1 fw-bold">📞 Contact:</p>
                    <p class="text-muted mb-0">+359 88 874 7824</p>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="container mb-5">
    <h3 class="fw-bold mb-4 text-center">Find Us Here</h3>
    <!-- The ratio class makes the iframe scale perfectly on mobile -->
    <div class="ratio ratio-21x9 shadow-sm rounded overflow-hidden">
        <!-- Replace the src below with your real Google Maps embed link -->
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d184.50524193066255!2d22.682896707833823!3d42.27673298560956!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14aa9dc9e88a7085%3A0x601aad37798d7c5!2z0KHQv9C-0YDRgtC10L0g0LrQu9GD0LEi0JDQv9C-0LvQvtC9IiDQmtGO0YHRgtC10L3QtNC40Ls!5e0!3m2!1sbg!2sbg!4v1788090211273!5m2!1sbg!2sbg" width="800" height="600" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
    </div>
</div>