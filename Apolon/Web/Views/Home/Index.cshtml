@{
    ViewData["Title"] = "Home Page";
}

<section class="hero-section">
    <div class="hero-content">
        <div class="hero-kicker">Built for people who refuse to settle</div>
        <h1>Train with purpose. Live with power.</h1>
        <p class="lead mb-4">Apolon is your complete performance system: expert coaching, structured workouts, and the tools to build your strongest self.</p>
        <div class="d-flex flex-wrap gap-3">
            <a asp-controller="Cards" asp-action="Index" class="btn btn-warning btn-lg px-4">Start your journey</a>
            <a asp-controller="Trainers" asp-action="Index" class="btn btn-outline-light btn-lg px-4">Meet the coaches</a>
        </div>
    </div>
</section>

<div class="page-heading">
    <div class="hero-kicker justify-content-center">Everything you need to progress</div>
    <h2 class="display-6 fw-bold">One place. No excuses.</h2>
    <p>Choose your next challenge and make every session count.</p>
</div>

<div class="mb-5">
    <div class="row g-4">
        
        <div class="col-md-6 col-lg-3">
            <div class="feature-card card border-0">
                <div class="card-body p-0 d-flex flex-column">
                    <div class="feature-icon">💪</div>
                    <h5 class="card-title fw-bold">Expert coaching</h5>
                    <p class="card-text text-muted mb-4">Meet coaches who turn ambition into measurable progress.</p>
                    <a asp-controller="Trainers" asp-action="Index" class="btn btn-outline-light mt-auto w-100">Meet the team</a>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 col-lg-3">
            <div class="feature-card card border-0">
                <div class="card-body p-0 d-flex flex-column">
                    <div class="feature-icon">🔥</div>
                    <h5 class="card-title fw-bold">Structured workouts</h5>
                    <p class="card-text text-muted mb-4">Follow focused programs designed to keep your momentum high.</p>
                    <a asp-controller="Workouts" asp-action="Index" class="btn btn-outline-light mt-auto w-100">Explore workouts</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="feature-card card border-0">
                <div class="card-body p-0 d-flex flex-column">
                    <div class="feature-icon">⚡</div>
                    <h5 class="card-title fw-bold">Fuel your edge</h5>
                    <p class="card-text text-muted mb-4">Shop trusted supplements selected for performance and recovery.</p>
                    <a asp-controller="Supplements" asp-action="Index" class="btn btn-outline-light mt-auto w-100">Visit the store</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="feature-card card border-0">
                <div class="card-body p-0 d-flex flex-column">
                    <div class="feature-icon">🎟️</div>
                    <h5 class="card-title fw-bold">Your membership</h5>
                    <p class="card-text text-muted mb-4">Get access to the space, support, and structure you need.</p>
                    <a asp-controller="Cards" asp-action="Index" class="btn btn-warning mt-auto w-100">View memberships</a>
                </div>
            </div>
        </div>

    </div>
</div>