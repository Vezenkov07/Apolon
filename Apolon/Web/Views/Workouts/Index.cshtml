@model IReadOnlyCollection<Apolon.Data.Models.Workout>

@{
    ViewData["Title"] = "Workouts";
}

<div class="py-4">
    <div class="page-heading">
        <div class="hero-kicker justify-content-center">Your next level starts here</div>
        <h1 class="display-5 fw-bold">Upcoming workouts</h1>
        <p>Train with structured programs led by our coaches.</p>
    </div>

    <div class="row row-cols-1 row-cols-md-2 g-4">
        @if (Model.Count == 0)
        {
            <div class="col-12">
                <div class="alert alert-info">No workouts are scheduled yet.</div>
            </div>
        }
        else
        {
            @foreach (var workout in Model)
            {
                <div class="col">
                    <div class="workout-card card border-0">
                        <div class="card-body d-flex flex-column">
                            <h2 class="h4">@workout.Split.SplitName</h2>
                            <p class="text-muted">
                                @workout.StartTime.ToLocalTime().ToString("ddd, dd MMM yyyy HH:mm")
                                – @workout.EndTime.ToLocalTime().ToString("HH:mm")
                            </p>
                            <p>Coach: @(workout.Trainer is null ? "Apolon team" : $"{workout.Trainer.FirstName} {workout.Trainer.LastName}")</p>
                            <a asp-action="Details" asp-route-id="@workout.WorkoutId" class="btn btn-outline-dark mt-auto">View workout</a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
