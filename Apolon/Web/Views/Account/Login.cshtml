@{
    ViewData["Title"] = "Log In";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: 90vh; background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.8)), url('https://images.unsplash.com/photo-1541534741688-6078c6bfb5c5?q=80&w=2069&auto=format&fit=crop') no-repeat center center; background-size: cover; margin: -1rem -1rem 0 -1rem; padding: 2rem;">
    
    <div class="card shadow-lg border-0 rounded-4" style="width: 100%; max-width: 450px; background-color: rgba(33, 37, 41, 0.95);">
        <div class="card-body p-5 text-white">
            <div class="text-center mb-4">
                <h2 class="fw-bold text-uppercase">🏋️‍♂️ Apolon Gym</h2>
                <p class="text-muted">Welcome back. Let's get to work.</p>
            </div>

            <form method="post" asp-action="Login">
                <div class="form-floating mb-3 text-dark">
                    <input type="email" class="form-control rounded-3" id="floatingEmail" placeholder="name@example.com" name="Email" required>
                    <label for="floatingEmail">Email address</label>
                </div>
                
                <div class="form-floating mb-3 text-dark">
                    <input type="password" class="form-control rounded-3" id="floatingPassword" placeholder="Password" name="Password" required>
                    <label for="floatingPassword">Password</label>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input class="form-check-input bg-dark border-secondary" type="checkbox" id="rememberMe" name="RememberMe">
                        <label class="form-check-label text-muted small" for="rememberMe">Remember me</label>
                    </div>
                    <a href="#" class="text-warning small text-decoration-none">Forgot password?</a>
                </div>

                <button class="btn btn-warning w-100 py-3 fw-bold rounded-3 mb-3 text-dark" type="submit">Log In</button>
            </form>

            <div class="text-center mt-3">
                <p class="text-muted small">Don't have an account? <a asp-action="Register" class="text-warning text-decoration-none fw-bold">Join Apolon Gym</a></p>
            </div>
        </div>
    </div>
</div>