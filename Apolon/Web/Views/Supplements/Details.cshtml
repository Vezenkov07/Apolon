@model Apolon.Data.Models.Supplement

@{
    ViewData["Title"] = Model.Name;
}

<div class="py-4">
    <a asp-action="Index" class="btn btn-outline-secondary mb-4">← Back to store</a>
    <div class="row g-4 align-items-start">
        <div class="col-md-5">
            <img src="https://images.unsplash.com/photo-1579722821273-0f6c7d44362f?q=80&w=1000&auto=format&fit=crop"
                 class="img-fluid rounded-4 shadow" alt="@Model.Name" />
        </div>
        <div class="col-md-7">
            <span class="badge bg-warning text-dark">@Model.Brand.BrandName</span>
            <span class="badge bg-secondary">@Model.Category.Category</span>
            <h1 class="fw-bold mt-3">@Model.Name</h1>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <p class="lead">@Model.Description</p>
            <p class="display-6 fw-bold text-warning">@Model.Price.ToString("F2") лв.</p>
            <form asp-controller="Supplements" asp-action="Buy" method="get" class="row g-2 align-items-end">
                <input type="hidden" name="id" value="@Model.SupplementId" />
                <div class="col-sm-4">
                    <label for="quantity" class="form-label">Quantity</label>
                    <input id="quantity" name="quantity" type="number" class="form-control" value="1" min="1" max="99" />
                </div>
                <div class="col-sm-8">
                    <button type="submit" class="btn btn-warning btn-lg w-100">Buy now</button>
                </div>
            </form>
            <p class="small text-muted mt-3">Purchases are recorded in your account. Payment processing can be connected later.</p>
        </div>
    </div>
</div>
