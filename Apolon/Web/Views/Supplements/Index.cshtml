@model IEnumerable<Apolon.Data.Models.Supplement>

@{
    ViewData["Title"] = "Supplements";
    //Layout = "~/Views/Shared/_Layout.cshtml";

    string? currentSortOrder = ViewBag.SortOrder?.ToString();
    string? action = ViewBag.Action?.ToString() ?? "Index";
    string? query = ViewBag.Query?.ToString();
}

<div class="py-4 mb-5">
    <div class="page-heading">
        <div class="hero-kicker justify-content-center">Performance nutrition</div>
        <h1 class="display-5 fw-bold">The fuel cabinet</h1>
        <p>Trusted essentials for training harder and recovering smarter.</p>
    </div>

    <div class="store-toolbar d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <form method="get" asp-controller="Supplements" asp-action="@action" class="d-flex flex-grow-1 flex-md-grow-0 gap-2 flex-wrap align-items-center ms-auto">
            <div class="input-group" style="max-width: 360px;">
                <input type="text" name="query" class="form-control" placeholder="Search supplements..." value="@query" />
                <button type="submit" class="btn btn-warning">
                    <i class="fas fa-search"></i>
                </button>
            </div>

            <div class="btn-group" role="group" aria-label="Sort by price">
                <button type="submit" name="sortOrder" value="asc" class="btn btn-outline-light @(currentSortOrder == "asc" ? "active" : "")">
                    Price: Low <i class="fas fa-arrow-up small ms-1"></i>
                </button>
                <button type="submit" name="sortOrder" value="desc" class="btn btn-outline-light @(currentSortOrder == "desc" ? "active" : "")">
                    Price: High <i class="fas fa-arrow-down small ms-1"></i>
                </button>
            </div>
        </form>
    </div>

    <!-- Product Grid -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var supplement in Model)
            {
                <div class="col">
                    <div class="supplement-card card border-0">
                        <!-- Default placeholder image -->
                        <img src="https://images.unsplash.com/photo-1579722821273-0f6c7d44362f?q=80&w=800&auto=format&fit=crop"
                             class="card-img-top"
                             alt="@supplement.Name" />

                        <div class="card-body d-flex flex-column p-4">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                @if (supplement.Brand != null)
                                {
                                    <span class="badge bg-warning text-dark me-1">@supplement.Brand.BrandName</span>
                                }
                                @if (supplement.Category != null)
                                {
                                    <span class="badge bg-secondary">@supplement.Category.Category</span>
                                }
                            </div>

                            <h5 class="card-title fw-bold text-truncate mb-2" title="@supplement.Name">@supplement.Name</h5>
                            
                            <p class="card-text text-muted small flex-grow-1">
                                @(string.IsNullOrEmpty(supplement.Description)
                                    ? "Premium gym supplement to boost performance and recovery." 
                                    : (supplement.Description.Length > 90 ? supplement.Description.Substring(0, 90) + "..." : supplement.Description))
                            </p>

                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top border-secondary">
                                <span class="fs-4 fw-bold text-warning">@supplement.Price.ToString("F2") лв.</span>
                                <a asp-controller="Supplements" asp-action="Details" asp-route-id="@supplement.SupplementId" class="btn btn-outline-light btn-sm fw-semibold">
                                    View Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
                <p class="text-muted fs-5">No supplements found matching your search criteria.</p>
            </div>
        }
    </div>
</div>
